rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(userId) { return signedIn() && request.auth.uid == userId; }
    match /users/{userId} {
      allow read, create, update: if owner(userId);
      allow delete: if false;
    }
    match /trips/{tripId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == resource.data.userId;
      allow create: if signedIn() && request.auth.uid == request.resource.data.userId;
    }
    match /expenses/{expenseId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == resource.data.userId;
      allow create: if signedIn() && request.auth.uid == request.resource.data.userId;
    }
    match /favourites/{favouriteId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == resource.data.userId;
      allow create: if signedIn() && request.auth.uid == request.resource.data.userId;
    }
  }
}
