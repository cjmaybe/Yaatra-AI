{
  "functions": {"source": "functions", "runtime": "nodejs22"},
  "hosting": {
    "public": "frontend",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{"source":"/api/**","function":{"functionId":"yaatraApi","region":"us-central1"}}],
    "headers": [{"source":"/sw.js","headers":[{"key":"Cache-Control","value":"no-cache"}]}]
  },
  "firestore": {"rules":"firestore.rules"}
}
